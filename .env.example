# Database
DATABASE_URL="postgresql://postgres@localhost:5432/your_database_name?schema=public"

# NextAuth
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3030"

# OAuth Providers (optional — kosongkan jika tidak dipakai)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# OpenRouter AI (daftar & buat API key di https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
